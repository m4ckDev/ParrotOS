[global]
    monitor = 0
    follow = mouse
    width = 360
    height = 120
    origin = top-right
    offset = 14x44
    notification_limit = 6
    frame_width = 2
    frame_color = "#ff2b2b"
    separator_color = frame
    font = monospace 10
    corner_radius = 10
    background = "#0b0b0d"
    foreground = "#f2f2f2"
    timeout = 5

[urgency_low]
    frame_color = "#5a5a5f"

[urgency_normal]
    frame_color = "#ff2b2b"

[urgency_critical]
    frame_color = "#ff2b2b"
    timeout = 0